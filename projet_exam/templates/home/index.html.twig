{% extends 'base.html.twig' %}

{% block title %}Centre de loisirs{% endblock %}

{% block body %}
    <div class="container my-5">

        {% include 'partials/_recherche-center.html.twig' with {'form': searchForm} %}


        <h1 class="text-center mb-4">Les centres de loisirs les plus fréquentés à Clermont-Ferrand</h1>


        <p>
            Faites vivre à vos enfants des moments magiques en Auvergne,
            entre aventures en plein air et jeux en espace couvert !
        </p>
        <div class="row">
            {% for center in centers %}

                {% include 'partials/_center_card.html.twig' with { 'center': center } %}

            {% else %}
                <p>Aucun centre trouvé.</p>
            {% endfor %}
        </div>

        <div class="mt-4">
            {{ knp_pagination_render(centers) }}
        </div>

        <h2>Localisez les centres de loisirs près de chez vous !</h2>
        <div id="map" data-map-data="{{ getSerializedPoints(centers.items) }}"></div>
    </div>
{% endblock %}
