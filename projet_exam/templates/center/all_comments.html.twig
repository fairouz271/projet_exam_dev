{% extends 'base.html.twig' %}

{% block title %}Commentaires - {{ center.name }}{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>Tous les commentaires pour {{ center.name }}</h1>

    <div class="row">
        {% for comment in comments %}
            <div class="col-md-6 col-lg-4 mb-4">
                {% include 'center/_comment_card.html.twig' with { 'comment': comment } %}
            </div>
        {% else %}
            <p>Aucun commentaire à afficher.</p>
        {% endfor %}
    </div>

    <div class="mt-4">
        {{ knp_pagination_render(comments) }}
    </div>

    <div class="mt-4">
        <a href="{{ path('app_show_center', { id: center.id }) }}" class="btn btn-secondary">
            Retour a la fiche du centre
        </a>
    </div>
</div>
{% endblock %}
