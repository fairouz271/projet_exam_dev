<div id="carouselExample{{ center.id }}" class="carousel slide" >
    <div class="carousel-inner">
        {% set groupedImages = center.images|batch(4, null) %}

        {% for group in groupedImages %}
            <div class="carousel-item {% if loop.first %}active{% endif %}">
                <div class="d-flex justify-content-center flex-wrap">
                    {% for image in group %}
                        {% if image %}
                            <div class="col-6 col-md-6 col-lg-3 p-1">
                                <img src="{{ image.path }}" class="img-fluid " alt="{{ center.name }}">
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        {% endfor %}
    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#carouselExample{{ center.id }}" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carouselExample{{ center.id }}" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>
